# ==============================================================================
# Gitignore — Tabulador de Respostas Abertas
# ==============================================================================

# Ambientes virtuais e caches
.venv/
venv/
__pycache__/
*.pyc
.pytest_cache/
.ui_check_tmp/

# Logs e arquivos de saída gerados pelo Tabulador
output/
output_teste/
output*/
**/llm_log/

# Dados de clientes e entregas dentro de projetos/<slug>/ (nuvem Turso preserva a revisão)
projetos/*/data/
projetos/*/output/
projetos/*/output_teste/
projetos/*/_sharepoint/

# Chaves e credenciais (NUNCA versionar)
.env
.env.*
!.env.example
credentials.json
token.json

# Arquivos de clientes, temporários e mídias
~$*
*.tmp
*.xlsx
*.xls
*.mp4
*.docx
*.zip
*.bak
SALVAR.txt

# Pastas locais e workspaces corporativos fora do escopo do Tabulador
_documentos/
_general/
_projetos_arquivados_desync/
projetos/ASSERTIVA/
projetos/AXEL/
projetos/Cesec/
projetos/INSPER/
projetos/petrobras/
projetos/Transpetro/
projetos/SESI_cat/
projetos/_laterais/
*.code-workspace
settings.local.json
.stfolder/
.stversions/
.stignore

# Windows system
desktop.ini
Thumbs.db
