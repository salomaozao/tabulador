# Repositório do Tabulador: versiona SÓ o código do tabulador e a definição do projeto SESI.
# Todo o resto da pasta jumppi (outros projetos) fica fora.
/*
!/.gitignore
!/projetos/
/projetos/*
!/projetos/SESI_cat/
# SESI_cat: só a definição do projeto e a memória (.brain); o resto é cópia local do tabulador e material de cliente
/projetos/SESI_cat/*
!/projetos/SESI_cat/.brain/
!/projetos/SESI_cat/LEIA-ME.md
!/projetos/SESI_cat/Abrir Tabulador.bat
!/projetos/SESI_cat/src/
/projetos/SESI_cat/src/*
!/projetos/SESI_cat/src/projeto.py
!/projetos/_laterais/
/projetos/_laterais/*
!/projetos/_laterais/tabulador/

# nunca versionar: chaves, dados de clientes e resultados (contêm respostas de pesquisa)
.env
.env.*
!.env.example
credentials.json
token.json
/projetos/SESI_cat/data/
**/output/
**/output_teste/
**/output*/
**/llm_log/
**/__pycache__/
*.pyc
~$*
*.tmp
*.xlsx
*.xls
*.mp4
*.docx
*.zip
*.bak
*_old_backup.py
.pytest_cache/
settings.local.json
SALVAR.txt
