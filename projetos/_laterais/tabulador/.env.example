OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-4.1
# ASSERTIVA_FONTE=caminho\para\Acompanhamento de campo.xlsx
# ASSERTIVA_OUTPUT=caminho\para\output

# Nuvem (Turso/libSQL) — se preenchidos, a revisão (respostas, frame, codificação) passa a ser
# guardada no banco em vez de em arquivo local, e fica igual para todo mundo que abrir o Tabulador.
# Ver instruções para criar o banco e pegar essas duas credenciais em docs/nuvem_turso.md.
# TABULADOR_TURSO_URL=libsql://<nome-do-banco>-<sua-org>.turso.io
# TABULADOR_TURSO_TOKEN=...

# Autenticação Corporativa Microsoft Entra ID (Azure AD)
# Deixe em branco para modo local livre (desenvolvimento).
# Preencha para ativar o login corporativo exclusivo para contas @jumppi.
# MICROSOFT_CLIENT_ID=
# MICROSOFT_CLIENT_SECRET=
# MICROSOFT_TENANT_ID=common
# AUTH_DOMINIO_PERMITIDO=jumppi
# FLASK_SECRET_KEY=

